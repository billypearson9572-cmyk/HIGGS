function createDrafts() {
  var props = PropertiesService.getScriptProperties();
  var done = parseInt(props.getProperty('done') || '0', 10);
  var created = 0;
  var limit = Math.min(done + BATCH, LEADS.length);

  for (var i = done; i < limit; i++) {
    var lead = LEADS[i];
    GmailApp.createDraft(lead.e, lead.s, lead.b.replace(/\\n/g, '\n'));
    created++;
  }

  props.setProperty('done', String(done + created));
  Logger.log(created + ' drafts created. Total done: ' + (done + created) + ' / ' + LEADS.length);
  if (done + created >= LEADS.length) {
    Logger.log('ALL DONE! Check Gmail > Drafts.');
    props.deleteProperty('done'); // reset for next campaign
  }
}

function resetProgress() {
  PropertiesService.getScriptProperties().deleteProperty('done');
  Logger.log('Progress reset.');
}
